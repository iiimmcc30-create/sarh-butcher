# ملاحم سرح API — placeholders only. Never copy SARH production secrets.

NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3001
APP_DEEP_LINK_SCHEME=malahm
APP_ANDROID_PACKAGE=com.sarh.butcher

DATABASE_URL=postgresql://butcher:change-me-butcher-db-password@localhost:5433/sarh_butcher
DIRECT_URL=postgresql://butcher:change-me-butcher-db-password@localhost:5433/sarh_butcher

REDIS_ENABLED=true
REDIS_URL=redis://localhost:6380
REDIS_KEY_PREFIX=butcherapp:

JWT_SECRET=change-me-butcher-jwt-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-butcher-refresh-secret-min-32-chars!!
JWT_ISSUER=malahm-sarh
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

SECRETS_ENCRYPTION_KEY=change-me-32-byte-hex-or-passphrase-for-daftra

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
DEV_OTP=true

NI_API_KEY=
NI_OUTLET_ID=
NI_WEBHOOK_SECRET=
NI_API_BASE=

STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=sarh-butcher

DAFTRA_OAUTH_CLIENT_ID=
DAFTRA_OAUTH_CLIENT_SECRET=
DAFTRA_OAUTH_REDIRECT_URI=http://localhost:3001/api/butchers/daftra/oauth/callback

ALLOWED_ORIGINS=http://localhost:8081,http://localhost:3002,http://localhost:3003
CRON_SECRET=change-me-cron-secret
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=change-me-in-development
