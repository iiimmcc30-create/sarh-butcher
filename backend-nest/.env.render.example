# ═══════════════════════════════════════════════════════════════════════════════
# Sarh Backend — Render Environment Variables
# انسخ كل سطر KEY=VALUE إلى Render → Web Service → Environment
# أو: Render → Bulk Import → الصق المحتوى (بدون التعليقات #)
# ═══════════════════════════════════════════════════════════════════════════════

# ── App (مطلوب) ──────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=10000
APP_URL=https://sarhsa.online
APP_DEEP_LINK_SCHEME=sarh
APP_ANDROID_PACKAGE=com.sarh.app

# ── Database — Supabase (مطلوب) ─────────────────────────────────────────────
# Transaction pooler للتطبيق (port 6543)
DATABASE_URL=postgresql://postgres.oovdlmpgsvnmasngwjew:YOUR_SUPABASE_PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connect_timeout=30
# Session pooler للـ migrations (port 5432)
DIRECT_URL=postgresql://postgres.oovdlmpgsvnmasngwjew:YOUR_SUPABASE_PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?connect_timeout=30

# ── Redis (required for queues, socket adapter, worker) ─────────────────────
REDIS_ENABLED=true
# Runtime prefers REDIS_URL (Render Key Value). REDIS_HOST is optional fallback.
# REDIS_URL=redis://red-XXXX:6379
# REDIS_HOST=red-XXXX
# REDIS_PORT=6379
# REDIS_PASSWORD=

# ── sarh-worker only (Background Worker — no PORT / no health check) ────────
# Docker Command: node dist/queue/worker.main.js
# SERVICE_MODE=worker
# Copy DATABASE_URL, DIRECT_URL, APP_URL, CRON_SECRET from sarh-api.

# ── JWT Auth (مطلوب — انسخ من .env القديم) ───────────────────────────────────
JWT_SECRET=CHANGE_ME_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_MIN_32_CHARS
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
SESSION_TTL_DAYS=30

# ── CORS (مطلوب) ─────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://sarhsa.online,https://www.sarhsa.online
# After the butcher dashboard is live, set the exact origin (not *.vercel.app):
# BUTCHER_DASHBOARD_URL=https://YOUR-PROJECT.vercel.app
# BUTCHER_DASHBOARD_VERCEL_HOSTS=YOUR-PROJECT.vercel.app
# BUTCHER_DASHBOARD_ALLOW_VERCEL is ignored in production.

# ── Network International — الدفع (مطلوب للمدفوعات) ──────────────────────────
NI_BASE_URL=https://api-gateway.ksa.ngenius-payments.com
NI_API_KEY=YOUR_NI_API_KEY
NI_OUTLET_ID=36a1f0d3-6a8f-4287-958f-f151ae17146d
NI_BASIC_AUTH=YOUR_NI_BASIC_AUTH_BASE64
NI_CHAIN_ID=NIANB0035
NI_REALM=ni
NI_WEBHOOK_SECRET=YOUR_NI_WEBHOOK_SECRET

# ── Storage / Media (اختياري — للرفع S3/Cloudinary) ────────────────────────
STORAGE_PROVIDER=s3
STORAGE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=me-south-1
AWS_S3_BUCKET=sarh-media
# AWS_BUCKET_NAME is a legacy alias accepted by runtime/validator.
# CLOUDINARY — required on Render/Railway (local /uploads is ephemeral)
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=safat

# ── Twilio — OTP (مطلوب لتسجيل الدخول بالجوال) ─────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# DEV_OTP=false

# ── Google Sign-In (اختياري) ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# ── Firebase Push (اختياري) ──────────────────────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Expo Push (اختياري) ──────────────────────────────────────────────────────
EXPO_ACCESS_TOKEN=

# ── Email SMTP (اختياري) ─────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=sarh@sarhsa.online

# ── Agora Live (اختياري) ─────────────────────────────────────────────────────
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# ── Knowledge Center (اختياري) ───────────────────────────────────────────────
KNOWLEDGE_AUTO_PUBLISH=true
KNOWLEDGE_MAX_ITEMS_PER_SOURCE=10
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Monitoring (اختياري) ─────────────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=info

# ── Rate limit / Cron (required in production) ────────────────────────────────
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000
CRON_SECRET=CHANGE_ME_CRON_SECRET

# ── Admin seed (اختياري — للسكربتات فقط) ─────────────────────────────────────
ADMIN_EMAIL=sarh@sarhsa.online
ADMIN_PASSWORD=change-me-in-production
