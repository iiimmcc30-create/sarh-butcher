# ملاحم سرح — Render placeholders only.
# NEVER paste Sarh production URLs, JWT, NI, Twilio, Firebase, or Cloudinary values.

# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=10000
# Set after independent DNS exists. Do not use sarhsa.online.
MALAHEM_APP_URL=https://CHANGE_ME
MALAHEM_API_URL=https://CHANGE_ME
APP_URL=https://CHANGE_ME
PUBLIC_API_URL=https://CHANGE_ME
APP_DEEP_LINK_SCHEME=malahm
APP_ANDROID_PACKAGE=com.sarh.butcher
JWT_ISSUER=malahm-sarh

# ── Independent PostgreSQL (database name must be sarh_butcher, never sarouh)
DATABASE_URL=postgresql://butcher:YOUR_PASSWORD@YOUR_HOST:5432/sarh_butcher
DIRECT_URL=postgresql://butcher:YOUR_PASSWORD@YOUR_HOST:5432/sarh_butcher
# Preferred alias (load-env.ts maps this onto DATABASE_URL):
# MALAHEM_DATABASE_URL=postgresql://butcher:YOUR_PASSWORD@YOUR_HOST:5432/sarh_butcher

# ── Independent Redis (Render Key Value). Do NOT point at Sarh Redis.
REDIS_ENABLED=true
# REDIS_URL=redis://red-XXXX:6379
# MALAHEM_REDIS_URL=redis://red-XXXX:6379
# REDIS_HOST is only for a dedicated Malahem Redis hostname — never localhost:6379
# REDIS_HOST=red-XXXX
# REDIS_PORT=6379
REDIS_KEY_PREFIX=butcherapp:

# ── Worker process (same env, no PORT health check)
# Docker Command: node dist/queue/worker.main.js
# SERVICE_MODE=worker

# ── JWT — generate NEW secrets. Do not reuse Sarh JWT_SECRET.
JWT_SECRET=CHANGE_ME_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_MIN_32_CHARS
# BUTCHER_JWT_SECRET=CHANGE_ME_MIN_32_CHARS
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
SESSION_TTL_DAYS=30

# ── CORS ─────────────────────────────────────────────────────────────────────
# Exact https origins only after domains exist. Never *.
# ALLOWED_ORIGINS=${MALAHEM_DASHBOARD_URL},${MALAHEM_ADMIN_URL}
ALLOWED_ORIGINS=

# ── Network International — NEW Malahem outlet + webhook. Never Sarh NI.
NI_BASE_URL=https://api-gateway.ksa.ngenius-payments.com
NI_API_KEY=YOUR_NI_API_KEY
NI_OUTLET_ID=YOUR_MALAHEM_OUTLET_ID
NI_WEBHOOK_SECRET=YOUR_NI_WEBHOOK_SECRET

# ── Storage ──────────────────────────────────────────────────────────────────
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=sarh-butcher

# ── Twilio — NEW Verify service. Do not reuse the Sarh SID.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# ── Daftra (new redirect URL under this API)
DAFTRA_OAUTH_CLIENT_ID=
DAFTRA_OAUTH_CLIENT_SECRET=
DAFTRA_OAUTH_REDIRECT_URI=
SECRETS_ENCRYPTION_KEY=CHANGE_ME_DAFTRA_ENCRYPTION_KEY

# ── Firebase / FCM — new project for Android package com.sarh.butcher
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Rate limit / Cron ────────────────────────────────────────────────────────
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000
CRON_SECRET=CHANGE_ME_CRON_SECRET

# ── Optional ─────────────────────────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=info
EMAIL_FROM=
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=change-me-in-production
