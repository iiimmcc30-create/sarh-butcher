# ملاحم سرح — development / staging only.
# NEVER copy SARH production secrets into this file or this repository.

# --- App ---
APP_NAME=ملاحم سرح
APP_DEEP_LINK_SCHEME=malahm
APP_ANDROID_PACKAGE=com.sarh.butcher
NODE_ENV=development

# --- Independent PostgreSQL (NOT SARH) ---
POSTGRES_USER=butcher
POSTGRES_PASSWORD=change-me-butcher-db-password
POSTGRES_DB=sarh_butcher
DATABASE_URL=postgresql://butcher:change-me-butcher-db-password@localhost:5432/sarh_butcher
DIRECT_URL=postgresql://butcher:change-me-butcher-db-password@localhost:5432/sarh_butcher

# --- Independent Redis (NOT SARH) ---
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=butcherapp:

# --- Independent auth (NOT SARH JWT_SECRET) ---
JWT_SECRET=change-me-butcher-jwt-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-butcher-refresh-secret-min-32-chars!!
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Daftra row encryption — independent of JWT_SECRET
SECRETS_ENCRYPTION_KEY=change-me-32-byte-hex-or-passphrase-for-daftra

# --- OTP (new Twilio Verify service — do not reuse SARH SID) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
DEV_OTP=true

# --- N-Genius (NEW outlet + webhook — never SARH production) ---
NI_API_KEY=
NI_OUTLET_ID=
NI_WEBHOOK_SECRET=
NI_API_BASE=

# --- Cloudinary (folder isolated; do not use safat) ---
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=sarh-butcher

# --- Daftra platform OAuth (new redirect URLs) ---
DAFTRA_OAUTH_CLIENT_ID=
DAFTRA_OAUTH_CLIENT_SECRET=
DAFTRA_OAUTH_REDIRECT_URI=http://localhost:3001/api/butchers/daftra/oauth/callback
DAFTRA_PRODUCT_SYNC_INTERVAL_MS=600000

# --- Expo / public URLs (staging later; not sarhsa.online) ---
PUBLIC_API_URL=http://localhost:3001
PUBLIC_SOCKET_URL=http://localhost:3002
EXPO_PUBLIC_API_URL=http://localhost:3001
EXPO_PUBLIC_SOCKET_URL=http://localhost:3002

# --- Dashboards ---
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SOCKET_URL=http://localhost:3002
NEXT_PUBLIC_BUTCHER_BASE_PATH=/butcher
NEXT_PUBLIC_ADMIN_BASE_PATH=/admin

# --- Butcher domain timers ---
BUTCHER_ORDER_UNPAID_EXPIRES_MINUTES=30
BUTCHER_ORDER_EXPIRY_CHECK_INTERVAL_MS=300000
RUN_UNPAID_ORDER_EXPIRY=true

# --- Observability (optional, independent project) ---
SENTRY_DSN=

# --- Socket / worker process roles ---
# SERVICE_MODE=api|worker|socket
