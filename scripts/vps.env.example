# Copy to /opt/sarh-butcher/.env on the VPS. NEVER commit the real file.
# NEVER copy values from /opt/sarh/.env.production.

APP_NAME="ملاحم سرح"
APP_DEEP_LINK_SCHEME=malahm
APP_ANDROID_PACKAGE=com.sarh.butcher
# staging = test APK / mock NI / DEV_OTP. Do not set production without new NI+Twilio.
NODE_ENV=staging

POSTGRES_USER=butcher
POSTGRES_PASSWORD=change-me-butcher-db-password
POSTGRES_DB=sarh_butcher

REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_KEY_PREFIX=butcherapp:

JWT_SECRET=change-me-butcher-jwt-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-butcher-refresh-secret-min-32-chars!!
JWT_ISSUER=malahm-sarh
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

SECRETS_ENCRYPTION_KEY=change-me-32-byte-hex-or-passphrase-for-daftra
CRON_SECRET=change-me-cron-secret

DEV_OTP=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

NI_API_KEY=
NI_OUTLET_ID=
NI_WEBHOOK_SECRET=
NI_API_BASE=

STORAGE_PROVIDER=local
CLOUDINARY_FOLDER=sarh-butcher

DAFTRA_OAUTH_CLIENT_ID=
DAFTRA_OAUTH_CLIENT_SECRET=

APP_URL=https://sarhsa.online
PUBLIC_API_URL=https://sarhsa.online/api/butcher
PUBLIC_SOCKET_URL=https://sarhsa.online
ALLOWED_ORIGINS=https://sarhsa.online
