# Malahem production placeholders. Never commit real secrets.
# Fresh launch: new empty database sarh_butcher. No Sarh data import.
# Replace <MALAHEM_PRODUCTION_DOMAIN> after DNS exists.

NODE_ENV=production
DEV_OTP=false
# API containers skip prisma migrate deploy on restart.
# Run migrate deploy once, explicitly, then leave this true.
SKIP_MIGRATIONS=true
# One-shot only (overrides skip for a single approved API start):
# RUN_MIGRATIONS=true

# --- REQUIRED CORE ---
MALAHEM_DATABASE_URL=postgresql://butcher:CHANGE_ME@postgres:5432/sarh_butcher
MALAHEM_DIRECT_URL=postgresql://butcher:CHANGE_ME@postgres:5432/sarh_butcher
POSTGRES_USER=butcher
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=sarh_butcher

MALAHEM_REDIS_URL=redis://:CHANGE_ME@redis:6379
REDIS_KEY_PREFIX=butcherapp:

BUTCHER_JWT_SECRET=CHANGE_ME_MIN_32_CHARS
BUTCHER_JWT_REFRESH_SECRET=CHANGE_ME_MIN_32_CHARS
JWT_ISSUER=malahm-sarh
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

MALAHEM_APP_URL=https://<MALAHEM_PRODUCTION_DOMAIN>
MALAHEM_API_URL=https://<MALAHEM_PRODUCTION_DOMAIN>
MALAHEM_DASHBOARD_URL=https://<MALAHEM_PRODUCTION_DOMAIN>
MALAHEM_ADMIN_URL=https://<MALAHEM_PRODUCTION_DOMAIN>
APP_URL=https://<MALAHEM_PRODUCTION_DOMAIN>
PUBLIC_API_URL=https://<MALAHEM_PRODUCTION_DOMAIN>
PUBLIC_SOCKET_URL=https://<MALAHEM_PRODUCTION_DOMAIN>
NEXT_PUBLIC_API_URL=https://<MALAHEM_PRODUCTION_DOMAIN>
NEXT_PUBLIC_SOCKET_URL=https://<MALAHEM_PRODUCTION_DOMAIN>
EXPO_PUBLIC_API_URL=https://<MALAHEM_PRODUCTION_DOMAIN>
EXPO_PUBLIC_SOCKET_URL=https://<MALAHEM_PRODUCTION_DOMAIN>
EXPO_PUBLIC_SOCKET_PATH=/socket.io

# Exact https origins only. Never * / localhost / sarhsa.online.
ALLOWED_ORIGINS=https://<MALAHEM_PRODUCTION_DOMAIN>

CRON_SECRET=CHANGE_ME
SECRETS_ENCRYPTION_KEY=CHANGE_ME

APP_DEEP_LINK_SCHEME=malahm
APP_ANDROID_PACKAGE=com.sarh.butcher

# Generate later (do not run these into this file now):
#   openssl rand -hex 32   # JWT / refresh / CRON_SECRET / SECRETS_ENCRYPTION_KEY
#   openssl rand -hex 24   # POSTGRES_PASSWORD / Redis password

# --- PAYMENT (new Malahem NI outlet — never Sarh) ---
MALAHEM_NI_BASE_URL=https://api-gateway.ksa.ngenius-payments.com
MALAHEM_NI_OUTLET_ID=CHANGE_ME
MALAHEM_NI_API_KEY=CHANGE_ME
MALAHEM_NI_WEBHOOK_SECRET=CHANGE_ME

# --- OTP (new Twilio Verify service — never Sarh SID) ---
TWILIO_ACCOUNT_SID=CHANGE_ME
TWILIO_AUTH_TOKEN=CHANGE_ME
TWILIO_VERIFY_SERVICE_SID=CHANGE_ME

# --- PUSH (new Firebase project for com.sarh.butcher) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- STORAGE ---
STORAGE_PROVIDER=cloudinary
CLOUDINARY_FOLDER=sarh-butcher
CLOUDINARY_CLOUD_NAME=CHANGE_ME
CLOUDINARY_API_KEY=CHANGE_ME
CLOUDINARY_API_SECRET=CHANGE_ME
# Or S3:
# STORAGE_PROVIDER=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_REGION=me-south-1

# --- OPTIONAL ---
SENTRY_DSN=
DAFTRA_OAUTH_CLIENT_ID=
DAFTRA_OAUTH_CLIENT_SECRET=
DAFTRA_OAUTH_REDIRECT_URI=https://<MALAHEM_PRODUCTION_DOMAIN>/api/butchers/daftra/oauth/callback
