# Local Malahem stack — no SARH production values.
APP_NAME="ملاحم سرح"
NODE_ENV=development
APP_DEEP_LINK_SCHEME=malahm
APP_ANDROID_PACKAGE=com.sarh.butcher

# Independent names (aliased onto DATABASE_URL / JWT_SECRET at boot)
MALAHEM_DATABASE_URL=postgresql://butcher:change-me-butcher-db-password@127.0.0.1:5433/sarh_butcher
MALAHEM_DIRECT_URL=postgresql://butcher:change-me-butcher-db-password@127.0.0.1:5433/sarh_butcher
BUTCHER_JWT_SECRET=change-me-butcher-jwt-secret-min-32-chars!!
BUTCHER_JWT_REFRESH_SECRET=change-me-butcher-refresh-secret-min-32-chars!!
JWT_ISSUER=malahm-sarh
MALAHEM_REDIS_URL=redis://127.0.0.1:6380
REDIS_KEY_PREFIX=butcherapp:
MALAHEM_NI_BASE_URL=
MALAHEM_NI_OUTLET_ID=
MALAHEM_NI_API_KEY=
MALAHEM_NI_WEBHOOK_SECRET=
CLOUDINARY_FOLDER=sarh-butcher
DEV_OTP=true
APP_URL=http://127.0.0.1:3001
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001
NEXT_PUBLIC_SOCKET_URL=http://127.0.0.1:3002
EXPO_PUBLIC_API_URL=http://127.0.0.1:3001
EXPO_PUBLIC_SOCKET_URL=http://127.0.0.1:3002
