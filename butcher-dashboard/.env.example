# Public API origin (not a secret). Used by Next rewrites AND inlined for any
# server-side fetch. Browser XHR goes to same-origin /api and is proxied.
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001

# Public Socket.IO origin (not a secret). Browser connects here directly;
# Socket CORS must allow this dashboard's https origin.
NEXT_PUBLIC_SOCKET_URL=http://127.0.0.1:3002

# Production: set after independent DNS exists. Do not use sarhsa.online.
# NEXT_PUBLIC_API_URL=${MALAHEM_API_URL}
# NEXT_PUBLIC_SOCKET_URL=${MALAHEM_APP_URL}
# Optional path-prefix compat only:
# NEXT_PUBLIC_BROWSER_API_BASE=/api/butcher
#
# JWT_SECRET must match the backend access-token secret so middleware can
# verify butcher_token cookies (HS256). Never commit the real value.
JWT_SECRET=change-me-min-32-characters-long!!
#
# Do not put JWT secrets, DB URLs, or Redis URLs in NEXT_PUBLIC_*.
# Do not invent a production domain until DNS is requested.
